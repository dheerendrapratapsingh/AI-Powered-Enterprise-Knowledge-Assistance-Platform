DATABASE_URL=sqlite:///./copilot.db
JWT_SECRET=your_jwt_secret_key_here

# Hybrid AI Engine Configuration
# 1. Primary Cloud Engine: Google Gemini (Fastest, zero GPU required)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 2. Local Fallback Engine: Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Embeddings & RAG Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K=5
SIMILARITY_THRESHOLD=0.20
MAX_CONTEXT_CHUNKS=5
UPLOAD_DIR=./data/documents
FAISS_DIR=./data/indexes
